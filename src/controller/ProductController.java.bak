package controller;

import view.ProductView;
import config.DBConnection;
import javax.swing.*;
import java.sql.*;

public class ProductController {

    public ProductController(ProductView view) {

        loadAllProducts(view);
        checkRestock(view);

        // Add product
        view.btnAdd.addActionListener(e -> {
            try {
                Connection con = DBConnection.getConnection();
                String sql = "INSERT INTO products(title,category,price,stock) VALUES (?,?,?,?)";
                PreparedStatement ps = con.prepareStatement(sql);
                ps.setString(1, view.txtTitle.getText());
                ps.setString(2, view.cmbCategory.getSelectedItem().toString());
                ps.setDouble(3, Double.parseDouble(view.txtPrice.getText()));
                ps.setInt(4, Integer.parseInt(view.txtStock.getText()));
                ps.executeUpdate();

                JOptionPane.showMessageDialog(null, "Product Added");
                loadAllProducts(view);
                checkRestock(view);

            } catch (Exception ex) {
                ex.printStackTrace();
            }
        });

        // Search
        view.btnSearch.addActionListener(e -> searchProducts(view));
    }

    private void loadAllProducts(ProductView view) {
        view.model.setRowCount(0);
        try {
            Connection con = DBConnection.getConnection();
            ResultSet rs = con.createStatement().executeQuery("SELECT * FROM products");
            while (rs.next()) {
                view.model.addRow(new Object[]{
                    rs.getInt("id"),
                    rs.getString("title"),
                    rs.getString("category"),
                    rs.getDouble("price"),
                    rs.getInt("stock")
                });
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private void searchProducts(ProductView view) {
        view.model.setRowCount(0);
        try {
            Connection con = DBConnection.getConnection();
            String sql = "SELECT * FROM products WHERE title LIKE ?";
            PreparedStatement ps = con.prepareStatement(sql);
            ps.setString(1, "%" + view.txtSearch.getText() + "%");
            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                view.model.addRow(new Object[]{
                    rs.getInt("id"),
                    rs.getString("title"),
                    rs.getString("category"),
                    rs.getDouble("price"),
                    rs.getInt("stock")
                });
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
	
	    private void checkRestock(ProductView view) {
        try {
            Connection con = DBConnection.getConnection();
            ResultSet rs = con.createStatement().executeQuery(
                "SELECT title, stock FROM products WHERE stock < 5"
            );

            StringBuilder alert = new StringBuilder();
            while (rs.next()) {
                alert.append(rs.getString("title"))
                     .append(" (Stock: ")
                     .append(rs.getInt("stock"))
                     .append(")\n");
            }

            if (alert.length() > 0) {
                JOptionPane.showMessageDialog(
                    null,
                    "⚠️ Restock Alert!\n\n" + alert,
                    "Low Stock Warning",
                    JOptionPane.WARNING_MESSAGE
                );
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}

